# Optional. Everything below shows its default; copy to .env only to change something.
# Docker Compose reads .env automatically, and so does `npm run dev` in backend/.

# --- Products ---
# fakestore = live Fake Store API. fixture = bundled snapshot, no upstream needed.
PRODUCT_SOURCE=fakestore
# The products the business has chosen as "top rated", in display order.
TOP_RATED_PRODUCT_IDS=1,5,9,14,15
FAKE_STORE_BASE_URL=https://fakestoreapi.com
PRODUCT_CACHE_TTL_SECONDS=300
UPSTREAM_TIMEOUT_MS=5000
IMAGE_TIMEOUT_MS=20000

# --- Email ---
# Compose defaults SMTP_HOST to mailpit. Outside Compose the default is localhost.
# SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Catalogue <no-reply@catalogue.local>
SALES_INBOX_EMAIL=sales@catalogue.local
ENQUIRY_RATE_LIMIT_PER_MINUTE=5

# --- Server ---
LOG_LEVEL=info
# Outside Compose only: Compose fixes these three to suit nginx and the container.
PORT=3000
HOST=0.0.0.0
TRUST_PROXY_HOPS=0

# --- Ports (Compose only) ---
WEB_PORT=8080
MAILPIT_UI_PORT=8025
